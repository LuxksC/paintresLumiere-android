<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-only brand theme; Compose draws everything, this only colors the window before the
         first frame so there is no white flash. -->
    <style name="Theme.PaintresLumiere" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:colorBackground">@color/background_primary</item>
    </style>

    <!-- Launch screen (androidx.core:core-splashscreen): brand background + logo, then hands over
         to Theme.PaintresLumiere. Same backport on Android 6–11, native API on 12+. -->
    <style name="Theme.PaintresLumiere.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.PaintresLumiere</item>
    </style>
</resources>
