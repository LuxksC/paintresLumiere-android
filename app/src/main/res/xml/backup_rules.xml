<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. The session file holds a ciphertext whose key lives in this device's
     Keystore; restored elsewhere it is undecryptable, so it is never backed up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="pl_session.xml" />
</full-backup-content>
