<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same rule as backup_rules.xml: the encrypted session never leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pl_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pl_session.xml" />
    </device-transfer>
</data-extraction-rules>
